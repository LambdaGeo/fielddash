# ==============================================================================
# Modelo de Segredos para o Streamlit Community Cloud (Settings -> Secrets)
#
# Para uso local: copie este arquivo para `.streamlit/secrets.toml`
# No Streamlit Cloud: cole o conteúdo abaixo na aba "Secrets" das configurações do app
# ==============================================================================

# 1. Configuração do Projeto a ser carregado
# Caminho para o arquivo .yaml do projeto ou diretório contendo projetos .yaml.
# Se não for informado, tentará a pasta 'projetos' ou o exemplo incluído 'exemplos/residuos/projeto.yaml'.
FIELDDASH_CONFIG = "exemplos/residuos/projeto.yaml"

# 2. Controle de Acesso da Equipe de Campo (Opcional, mas recomendado)
# Se preenchido, o dashboard exibirá uma tela de acesso restrito.
# Membros da equipe podem acessar digitando o código ou abrindo o link com o token:
# Exemplo de link: https://seu-app.streamlit.app/?token=SEU_CODIGO_AQUI
FIELD_ACCESS_PIN = "sua_senha_ou_pin_da_equipe"

# 3. Credenciais do Epicollect5 (apenas para projetos privados)
# O prefixo deve coincidir com o valor de `credenciais:` (ou `credentials:`) definido no .yaml.
# Exemplo para `credenciais: RESIDUOS`:
# RESIDUOS_CLIENT_ID = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# RESIDUOS_CLIENT_SECRET = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
