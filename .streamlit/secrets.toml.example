# ==============================================================================
# Secrets template for Streamlit Community Cloud (Settings -> Secrets)
#
# Local use: copy this file to `.streamlit/secrets.toml` (git-ignored)
# Streamlit Cloud: paste the content below into the app's "Secrets" tab
# ==============================================================================

# 1. Project to load
# Path to the project .yaml file, or a folder containing project .yaml files.
# If omitted, falls back to a local 'projects' folder, then to the bundled
# example 'examples/waste/project.yaml' (anonymized data).
FIELDDASH_CONFIG = "examples/waste/project.yaml"

# 2. Field-team access control (optional, but recommended)
# When set, the dashboard shows a restricted-access screen. Team members enter the
# code or open a link with the token: https://your-app.streamlit.app/?token=YOUR_CODE
FIELD_ACCESS_PIN = "your_team_pin"

# 3. Epicollect5 credentials (only for private projects)
# The prefix must match `credentials:` in the project .yaml.
# Example for `credentials: WASTE`:
# WASTE_CLIENT_ID = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# WASTE_CLIENT_SECRET = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
